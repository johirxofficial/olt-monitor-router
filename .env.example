# ---------------------------------------------------------------------------
#  Copy this file to ".env" and fill in your real credentials.
#  Values here are referenced from config/config.yaml as "${VARIABLE_NAME}"
# ---------------------------------------------------------------------------

# --- MikroTik RouterOS API ---
ROUTER_HOST=198.51.100.1
ROUTER_API_PORT=8728
ROUTER_USER=admin
ROUTER_PASSWORD=

# --- OLT SNMP ---
# (also settable directly in config/config.yaml)
OLT_HOST=192.0.2.10
OLT_COMMUNITY=your-community

# --- MySQL ---
#  One-time setup creates this database/user:
#      python3 tools/setup_mysql.py
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=olt_monitor
DB_USER=olt_monitor
DB_PASSWORD=change-me

# --- web ---
APP_PORT=5002
